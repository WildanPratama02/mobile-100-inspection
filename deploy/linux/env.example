# /opt/m100/.env  (0640 root:m100; never in git or in a release). install.sh copies this file once and replaces
# __APP_PASSWORD__ and __MIGRATE_PASSWORD__ with with random values; the API stops and names the variable when one is missing or wrong.
NODE_ENV=production
TZ=Asia/Jakarta
PORT=3110
LOG_LEVEL=info

DATABASE_URL=postgres://m100_app:__APP_PASSWORD__@127.0.0.1:5432/m100
MIGRATE_DATABASE_URL=postgres://m100_migrate:__MIGRATE_PASSWORD__@127.0.0.1:5432/m100

PHOTO_STORE=disk
PHOTO_DIR=/opt/m100/photos
JWT_KEY_FILE=/opt/m100/secrets/jwt.key

PUBLIC_HOST=m100.qdms.web.id

# Backups: a disk or share other than the data disk.
BACKUP_DIR=/var/backups/m100
# Folder of pg_dump 18 when it is not on PATH (check: rpm -ql postgresql18 | grep bin/pg_dump).
#PG_BIN=/usr/pgsql-18/bin
