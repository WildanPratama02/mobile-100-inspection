{
  "name": "mobile-100-inspection",
  "private": true,
  "description": "Mobile 100% Inspection (M100): tap-only tablet PWA and NestJS API for PSI footwear inspection",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm --filter web e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e:install": "pnpm --filter web exec playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
