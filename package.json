{
  "name": "mobile-100-inspection",
  "private": true,
  "description": "Mobile 100% Inspection (M100): tap-only tablet PWA and NestJS API for PSI footwear inspection",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:admin": "pnpm --filter admin dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:load": "pnpm --filter api test:load",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm --filter web e2e && pnpm --filter admin e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e:install": "pnpm --filter web exec playwright install chromium",
    "db:bootstrap": "pnpm --filter api db:bootstrap",
    "db:migrate": "pnpm --filter api db:migrate",
    "admin:create": "pnpm --filter api admin:create",
    "import-master": "pnpm --filter api import-master",
    "device:add": "pnpm --filter api device:add",
    "device:revoke": "pnpm --filter api device:revoke",
    "device:list": "pnpm --filter api device:list",
    "sweep-photos": "pnpm --filter api sweep-photos",
    "backup": "pnpm --filter api backup",
    "backup:restore": "pnpm --filter api backup:restore",
    "release": "pnpm --filter deploy release"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
