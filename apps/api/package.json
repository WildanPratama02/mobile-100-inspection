{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "Mobile 100% Inspection API (NestJS)",
  "scripts": {
    "build": "pnpm --filter @m100/shared build && nest build",
    "start": "node dist/main.js",
    "start:dev": "pnpm --filter @m100/shared build && nest start --watch",
    "db:bootstrap": "pnpm run build && node dist/cli/db-bootstrap.js",
    "db:migrate": "pnpm run build && node dist/cli/db-migrate.js",
    "import-master": "pnpm run build && node dist/cli/import-master.js",
    "device:add": "pnpm run build && node dist/cli/device-add.js",
    "device:revoke": "pnpm run build && node dist/cli/device-revoke.js",
    "device:list": "pnpm run build && node dist/cli/device-list.js",
    "sweep-photos": "pnpm run build && node dist/cli/sweep-photos.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@m100/shared": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/throttler": "6.7.1",
    "busboy": "1.6.0",
    "csv-parse": "7.0.3",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "read-excel-file": "9.3.10",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/busboy": "1.5.4",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "yaml": "2.9.1"
  },
  "jest": {
    "testTimeout": 30000,
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@m100/shared$": "<rootDir>/../../../packages/shared/src/index.ts"
    }
  }
}
