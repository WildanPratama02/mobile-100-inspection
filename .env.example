# Mobile 100% Inspection API configuration (doc 03 §7.4, ADR-018: PostgreSQL 16 and a photo store).
# Copy to apps/api/.env for development (the API and the CLI read .env from their working directory; on the server,
# the install folder). Fill in real values there. Never commit .env or anything under secrets/.

# --- Database (doc 03 §6) ---
# Runtime role m100_app. Development uses m100_dev, never the production database.
DATABASE_URL=postgresql://m100_app:CHANGE_ME@127.0.0.1:5432/m100_dev
# Role m100_migrate, used only by `pnpm db:migrate`.
MIGRATE_DATABASE_URL=postgresql://m100_migrate:CHANGE_ME@127.0.0.1:5432/m100_dev

# PostgreSQL administrator: only for the one-time `pnpm db:bootstrap`. Remove afterwards.
ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres
# Password of the read-only reporting role m100_report (set by `pnpm db:bootstrap`). Remove afterwards.
REPORT_DB_PASSWORD=CHANGE_ME

# Local integration tests (*.db.spec.ts create and drop m100_test_* databases) — never configure for production.
TEST_ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres

# --- Photos (doc 03 §5.2) ---
# Release 1 uses a folder (disk). s3 needs S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY and S3_SECRET_KEY instead.
PHOTO_STORE=disk
PHOTO_DIR=D:\m100\photos
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=m100-photos
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- Tokens and tablets (doc 04 §2, doc 03 §4.9, §7.5) ---
# File of at least 32 random bytes; an absolute path (a relative one is taken from the working directory). Create it with
#   node -e "require('fs').writeFileSync('secrets/jwt.key', require('crypto').randomBytes(32))"
JWT_KEY_FILE=D:\Project\mobile-100-inspection\secrets\jwt.key
# Host of the setup link printed by `pnpm device:add` and of the Caddyfile (ADR-016).
PUBLIC_HOST=m100.qdms.web.id
# Cloudflare API token for the certificate DNS challenge (server only, doc 03 §7.2.1).
# CF_API_TOKEN=

# --- Runtime ---
TZ=Asia/Jakarta
LOG_LEVEL=info
# The API listens on 127.0.0.1 only; Caddy forwards /v1/* to it (doc 03 §7.1).
PORT=3000
# Tunables with the defaults of doc 04 and doc 03 §5 (seconds).
MASTER_CHECK_SECONDS=300
SUBMIT_TIMEOUT_SECONDS=60

# --- Tests only ---
# Folder of the real master-data exports for import-master.real.db.spec.ts; keep them under secrets/.
# MASTER_DATA_DIR=D:\Project\mobile-100-inspection\secrets
