# Mobile 100% Inspection API configuration (doc 03 §7.4).
# Copy to .env and fill in. Never commit .env or anything under secrets/.

# Spreadsheet to use. Development and tests: the COPY of "100%INLINE IMPACTIVA", never production.
SHEET_ID=
# Drive folder for photos (development: a test folder).
DRIVE_IMAGES_FOLDER_ID=

# Paths to files under secrets/ (git-ignored).
GOOGLE_SA_KEY_FILE=secrets/service-account.json
GOOGLE_OAUTH_FILE=secrets/drive-oauth.json
JWT_KEY_FILE=secrets/jwt.key
DEVICES_FILE=secrets/devices.json

# Tunables (defaults from doc 04 and doc 03 §5).
MASTER_REFRESH_MINUTES=30
SUBMIT_WAIT_SECONDS=20
SUBMIT_RETRY_MINUTES=10

# API listens on 127.0.0.1 only; Caddy forwards /v1/* to it (doc 03 §7.1).
PORT=3000

# Public host name, used in the Caddyfile and the setup link (ADR-016).
PUBLIC_HOST=m100.qdms.web.id
# Cloudflare API token for the certificate DNS challenge (server only).
CF_API_TOKEN=

TZ=Asia/Jakarta
LOG_LEVEL=info
